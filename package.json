{
  "name": "aryaptrha-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "cf": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply aryaptrha-portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply aryaptrha-portfolio-db --remote",
    "db:list": "wrangler d1 migrations list aryaptrha-portfolio-db --local",
    "db:console": "wrangler d1 execute aryaptrha-portfolio-db --local --command"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "gsap": "^3.15.0",
    "hono": "^4.12.30",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=22"
  }
}
