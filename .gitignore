# Wrangler local secrets (worker vars for `wrangler dev`).
# The `.example` template is the one file here that must stay tracked — it is the
# only record of which vars a fresh clone needs, and `.dev.vars.*` would swallow it.
.dev.vars
.dev.vars.*
!.dev.vars.example

# Wrangler/miniflare local state: a sqlite cache plus per-run build bundles.
# Regenerated on every `wrangler dev`, so committing it only creates diff noise.
.wrangler/

# Crash dumps (Cygwin/Git-Bash drops these in the cwd)
*.stackdump

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

.eslintcache

# Cypress
/cypress/videos/
/cypress/screenshots/

# Vitest
__screenshots__/

# Vite
*.timestamp-*-*.mjs

# Claude Code
CLAUDE.md

# Per-machine settings, and git worktrees created by EnterWorktree.
#
# `worktrees/` matters beyond diff noise: a worktree directory holds a `.git`
# *file*, so `git add -A` records it as a gitlink (mode 160000) rather than
# walking into it. With no `.gitmodules` to match, Cloudflare's build then fails
# at "error occurred while updating repository submodules" while cloning.
#
# Scoped rather than ignoring `.claude/` wholesale, so shared config (agents,
# skills, a committed settings.json) can still be tracked if that's ever wanted.
.claude/settings.local.json
.claude/worktrees/
