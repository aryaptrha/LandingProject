# Local worker vars for `wrangler dev` (npm run cf).
#
# Copy to `.dev.vars` and fill in. That file is gitignored and does NOT survive a
# clone, so this template is the only thing telling a new machine what it needs.
#
#   cp .dev.vars.example .dev.vars
#
# These are worker-side only. They are never bundled into the client — the browser
# always calls the worker's own /api/chat and the worker proxies upstream. Never
# move any of these to a VITE_ var: Vite inlines those into the shipped JS.
#
# In production these are set with `npx wrangler secret put <NAME>` instead.
# See docs/DEPLOYMENT.md.

# Base URL of the Arya persona backend. The worker appends /api/chat, so give the
# bare host here. A full https://host/api/chat is also accepted.
# Leave unset to exercise the canned-reply fallback in src/worker/routes/chat.ts.
PERSONA_API_URL=https://api.example.com

# Origin presented to the backend, which enforces an origin allowlist.
# REQUIRED LOCALLY: a server-side fetch sends no Origin header, and the worker's
# own origin here is 127.0.0.1, which your allowlist will reject. In production
# this is omitted so it defaults to the real site origin.
PERSONA_ORIGIN=https://aryaptrha.fun

# Optional bearer token for the backend. Omit entirely if it needs no auth.
# PERSONA_API_KEY=your_token_here

# ---------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection & Session Signing (Worker Secrets)
#
# Secret key for server-side siteverify & X-Session-Token signing:
# In development, you can use Cloudflare's dummy test secret:
#   - Always passes: 1x0000000000000000000000000000000AA
#   - Always blocks: 2x0000000000000000000000000000000AB
#
# In production, set via:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: dedicated secret for HMAC session token signing.
# Defaults to TURNSTILE_SECRET_KEY if not provided.
# SESSION_SECRET=your_random_secret_string

# Optional: comma-separated hostname allowlist for validation
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1,aryaptrha.fun

# ---------------------------------------------------------------------------
# OpenWeather (Worker Secret)
#
# Powers GET /api/weather, which reads the visitor's coordinates from
# `request.cf` at the edge, rounds them to two decimals, and asks OpenWeather's
# free Current Weather endpoint (/data/2.5/weather).
#
# Get a key at https://home.openweathermap.org/api_keys. A new key takes a few
# minutes to activate; until it does, OpenWeather answers 401 and the panel shows
# an upstream error rather than a temperature.
#
# Leave this unset to exercise the unconfigured path: /api/weather answers 503
# WEATHER_UNCONFIGURED and the Edge Weather panel hides itself. There is
# deliberately no sample payload — an invented temperature is misinformation, and
# a hidden panel is not.
#
# `geoSource` in the response says where the coordinates came from. Wrangler's
# miniflare does supply a plausible `cf` locally, coordinates included, so this
# usually reads `edge` in dev rather than `fallback` — don't expect the Jakarta
# fallback to be the local default. It covers a real edge request whose `cf` has no
# coordinates, which does happen. Either way the location is the only thing that
# falls back; the weather is always real.
#
# In production:
#   npx wrangler secret put OPENWEATHER_API_KEY
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_key_here
