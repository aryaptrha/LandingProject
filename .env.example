# Personal Persona AI Chat - Environment Configuration Example
# Copy this file to `.env` or `.env.local` for your local development or deployment settings.

# Backend Base URL or Full Persona Endpoint URL (POST)
# Examples:
# - Base URL: https://api.yourdomain.com (will automatically append /api/chat)
# - Full Endpoint URL: https://api.yourdomain.com/api/chat
# - Local Dev default: /api/chat
VITE_PERSONA_API_URL=https://your-backend-domain.com

# Optional Authorization Bearer Token / API Key
# VITE_API_KEY=your_optional_api_key_here
